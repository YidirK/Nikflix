{
  "name": "Nikflix (Household Bypass)",
  "description": "Bypass the account-sharing restrictions on Netflix.",
  "version": "1.9.4",
  "manifest_version": 3,
  "default_locale": "en",
  "action": {
    "default_icon": "icons/Nikflix-48.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
        "resources": [
          "netflix-seeker.js",
          "netflix-audioChange.js",
          "netflix-substitleChange.js"
        ],
        "matches": ["*://*.netflix.com/*"]
    }
  ],
  "content_scripts": [
    {
      "js": ["native-mode-bridge.js"],
      "matches": [
        "*://*.netflix.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": ["native-mode-page.js"],
      "matches": [
        "*://*.netflix.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": ["Main.js"],
      "css": ["netflix-controller.css"],
      "matches": [
        "*://*.netflix.com/*"
      ]
    }
  ]
}
