---
import { Star, GitBranch, Users, ExternalLink, CodeXml } from 'lucide-react';
import type { Locale, Translations } from '../utils/i18n';
import GithubIcon from '../components/icons/GithubIcon.astro';

interface Props {
  lang: Locale;
  t: Translations;
}

const { lang, t } = Astro.props;

const REPO_OWNER = 'YidirK';
const REPO_NAME = 'Nikflix';

let stats = { stars: 0, forks: 0, openIssues: 0 };
let contributors: Array<{ id: number; login: string; avatar_url: string; html_url: string; contributions: number }> = [];

try {
  const [repoRes, contribRes] = await Promise.all([
    fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}`, { headers: { 'User-Agent': 'Nikflix-Website' } }),
    fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contributors`, { headers: { 'User-Agent': 'Nikflix-Website' } })
  ]);

  if (repoRes.ok) {
    const repoData = await repoRes.json();
    stats.stars = repoData.stargazers_count || 0;
    stats.forks = repoData.forks_count || 0;
    stats.openIssues = repoData.open_issues_count || 0;
  }

  if (contribRes.ok) {
    const contribData = await contribRes.json();
    if (Array.isArray(contribData)) contributors = contribData;
  }
} catch (err) {
  console.warn('GitHub API fetch failed:', err);
}
---

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    opacity: 0;
  }
</style>

<section id="contributors" class="py-24 bg-white border-y border-gray-100 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-emerald-50/50 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 border border-gray-200 text-gray-700 text-xs font-semibold mb-6 uppercase tracking-wide">
        <GithubIcon class="w-3.5 h-3.5" />
        Open Source
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">
        {t.github.title}
      </h2>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
        {t.github.subtitle}
      </p>
    </div>

    <!-- Stats Row (Bento Style) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12">
      <div class="animate-fade-in-up bg-white rounded-2xl p-6 border border-gray-200/60 shadow-sm hover:shadow-lg hover:border-emerald-200/60 transition-all duration-300 hover:-translate-y-1 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-100">
          <Star className="w-5 h-5" />
        </div>
        <div>
          <div class="text-3xl font-bold text-gray-900 tracking-tight">{stats.stars}</div>
          <div class="text-sm font-medium text-gray-500">{t.github.stars}</div>
        </div>
      </div>

      <div class="animate-fade-in-up bg-white rounded-2xl p-6 border border-gray-200/60 shadow-sm hover:shadow-lg hover:border-emerald-200/60 transition-all duration-300 hover:-translate-y-1 flex items-center gap-4" style="animation-delay: 100ms;">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100">
          <GitBranch className="w-5 h-5" />
        </div>
        <div>
          <div class="text-3xl font-bold text-gray-900 tracking-tight">{stats.forks}</div>
          <div class="text-sm font-medium text-gray-500">Forks</div>
        </div>
      </div>

      <div class="animate-fade-in-up bg-white rounded-2xl p-6 border border-gray-200/60 shadow-sm hover:shadow-lg hover:border-emerald-200/60 transition-all duration-300 hover:-translate-y-1 flex items-center gap-4" style="animation-delay: 200ms;">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100">
          <Users className="w-5 h-5" />
        </div>
        <div>
          <div class="text-3xl font-bold text-gray-900 tracking-tight">{contributors.length || 1}</div>
          <div class="text-sm font-medium text-gray-500">{t.github.contributors}</div>
        </div>
      </div>
    </div>

    <!-- Contributors List -->
    <div class="animate-fade-in-up bg-gray-50/50 rounded-2xl p-6 sm:p-8 border border-gray-200/60" style="animation-delay: 300ms;">
      <div class="flex items-center justify-between mb-8">
        <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
          <CodeXml className="w-5 h-5 text-emerald-600" />
          {t.github.contributors}
        </h3>
        <a
            href={`https://github.com/${REPO_OWNER}/${REPO_NAME}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors group"
        >
          <span>{t.github.viewRepo}</span>
          <ExternalLink className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
        </a>
      </div>

      {contributors.length > 0 ? (
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {contributors.map((c) => (
                <a
                    href={c.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-col items-center p-4 rounded-xl bg-white border border-gray-200/60 hover:border-emerald-200 hover:shadow-md transition-all duration-300 hover:-translate-y-1"
                >
                  <img
                      src={c.avatar_url}
                      alt={c.login}
                      class="w-12 h-12 rounded-full border-2 border-white shadow-sm group-hover:border-emerald-500 group-hover:scale-105 transition-all duration-300"
                  />
                  <span class="mt-3 text-sm font-semibold text-gray-700 truncate w-full text-center group-hover:text-emerald-700 transition-colors">
                    @{c.login}
                  </span>
                  <span class="text-xs text-gray-400 mt-1 font-medium">
                    {c.contributions} {c.contributions === 1 ? 'commit' : 'commits'}
                  </span>
                </a>
            ))}
          </div>
      ) : (
          <div class="text-center py-8">
            <a
                href={`https://github.com/${REPO_OWNER}/${REPO_NAME}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white hover:bg-gray-50 text-gray-700 font-semibold border border-gray-200 hover:border-emerald-200 transition-all duration-200"
            >
              <GithubIcon class="w-4 h-4" />
              <span>@{REPO_OWNER} (Project Author)</span>
            </a>
          </div>
      )}
    </div>
  </div>
</section>