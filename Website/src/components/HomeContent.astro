  <div class="space-y-3">
    {t.faq.items.map((item, index) => (
        <details class="group bg-white rounded-xl border border-gray-200/60 shadow-sm overflow-hidden transition-all duration-300 hover:border-emerald-200/60" style={`animation: fadeInUp 0.5s ease-out forwards; opacity: 0; animation-delay: ${index * 75}ms`}>
          <summary class="w-full px-6 py-5 cursor-pointer flex items-center justify-between gap-4 font-semibold text-gray-900 text-base focus:outline-none select-none">
            <span>{item.question}</span>
            <ChevronDown className="w-5 h-5 text-gray-400 group-open:rotate-180 group-open:text-emerald-600 transition-all duration-300 shrink-0" />
          </summary>
          <div class="px-6 pb-6 pt-1 text-gray-500 text-sm sm:text-base leading-relaxed border-t border-gray-100">
            {item.answer}
          </div>
        </details>
    ))}
  </div>
</section>


<!-- Changelog Section -->
