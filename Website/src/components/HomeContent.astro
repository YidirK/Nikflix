      {githubReleases.map((release, index) => (
          <details
              open={index === 0}
              class="group bg-white rounded-xl border border-gray-200/60 shadow-sm overflow-hidden transition-all duration-300 hover:border-emerald-200/60"
              style={`animation: fadeInUp 0.5s ease-out forwards; opacity: 0; animation-delay: ${index * 75}ms`}
          >
            <summary class="w-full px-6 py-5 cursor-pointer flex items-center justify-between gap-4 focus:outline-none select-none">
              <div class="flex items-center gap-3 flex-wrap">
              <span class="px-3 py-1 bg-emerald-50 text-emerald-700 rounded-md text-xs font-bold border border-emerald-100 uppercase tracking-wide">
                {release.tag_name}
                {release.prerelease && (
                    <span class="ml-1 text-amber-600 normal-case">(pre-release)</span>
                )}
              </span>
                {release.name && release.name !== release.tag_name && (
                    <span class="text-sm font-semibold text-gray-800">{release.name}</span>
                )}
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs text-gray-400 font-mono">{formatDate(release.published_at)}</span>
                <ChevronDown className="w-5 h-5 text-gray-400 group-open:rotate-180 group-open:text-emerald-600 transition-all duration-300" />
              </div>
            </summary>

            <div class="px-6 pb-6 pt-1 border-t border-gray-100">
              <ul class="space-y-3 text-sm text-gray-600 mt-4">
                {parseReleaseBody(release.body).map((change) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                      <span>{change}</span>
                    </li>
                ))}
              </ul>

<a
              href={release.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-4 text-xs font-semibold text-emerald-600 hover:text-emerald-700 transition-colors"
              >
      {t.changelog.check}
              </a>
            </div>
          </details>
        ))}
        </div>
        </div>
        </section>


<!-- Footer -->
<footer class="py-12 bg-white border-t border-gray-100 text-gray-500 text-xs sm:text-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <img src="/Nikflix-64.png" alt="Nikflix" class="w-6 h-6 opacity-70 grayscale hover:grayscale-0 transition-all duration-300" />
      <span class="font-bold text-gray-900">Nikflix</span>
      <span class="text-gray-400">© {new Date().getFullYear()} {t.footer.rights}</span>
    </div>

    <p class="text-gray-400 text-center md:text-right max-w-md leading-relaxed">
      {t.footer.disclaimer}
    </p>
  </div>
</footer>