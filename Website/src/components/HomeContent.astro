          href="https://chromewebstore.google.com/detail/nikflix/knjoabokknkpkhbbdclmnjcoeedmgema"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-gray-900 hover:bg-gray-800 text-white transition-all duration-200 shadow-lg shadow-gray-900/10 hover:shadow-gray-900/20 hover:-translate-y-0.5 active:scale-95"
      >
        <Download className="w-4 h-4" />
        <span>{t.nav.download}</span>
