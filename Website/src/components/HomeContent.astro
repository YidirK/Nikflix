---
import GitHubSection from './GitHubSection.astro';
import type { Locale, Translations } from '../utils/i18n';
import { locales, getLocalizedPath } from '../utils/i18n';
import { Download, Sparkles, ShieldCheck, Globe, Zap, Users, ChevronDown, Star  } from 'lucide-react';
import ChromeIcon from '../components/icons/ChromeIcon.astro';
import GithubIcon from '../components/icons/GithubIcon.astro';

interface Props {
  lang: Locale;
  t: Translations;
}

const { lang, t } = Astro.props;
const currentPath = Astro.url.pathname;

function renderHeroTitle(raw: string) {
  return raw.replace(
      /<gradient>(.*?)<\/gradient>/,
      '<span class="text-transparent bg-clip-text bg-gradient-to-br from-emerald-600 to-teal-500">$1</span>'
  );
}


const storeStats = {
  chrome: { rating: 4.9, reviews: '2,400+', users: '45k+' },
  firefox: { rating: 4.8, reviews: '850+', users: '8k+' }
};

interface GithubRelease {
  tag_name: string;
  name: string | null;
  published_at: string;
  body: string | null;
  html_url: string;
  prerelease: boolean;
  draft: boolean;
}

const REPO_OWNER = 'YidirK';
const REPO_NAME = 'Nikflix';


let githubReleases: GithubRelease[] = [];
try {
  const res = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases`,
      {
        headers: {
          Accept: 'application/vnd.github+json',
          // Optionnel, recommandé si tu build souvent (évite le rate-limit) :
          // Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,
        },
      }
  );

  if (res.ok) {
    const all: GithubRelease[] = await res.json();
    githubReleases = all.filter((r) => !r.draft); // on garde aussi les pre-releases si tu veux
  } else {
    console.error('Erreur GitHub API:', res.status, await res.text());
  }
} catch (err) {
  console.error('Impossible de récupérer les releases GitHub:', err);
}

// Transforme le body markdown d'une release en liste de lignes affichables
function parseReleaseBody(body: string | null): string[] {
  if (!body) return [];
  return body
      .split('\n')
      .map((line) => line.trim())
      .filter((line) => line.length > 0 && !line.startsWith('#')) // ignore les titres markdown
      .map((line) => line.replace(/^[-*]\s+/, '')); // enlève les puces "- " ou "* "
}

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

---

<style>
  /* Fintech-grade animations & utilities */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    opacity: 0;
  }
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
    opacity: 0;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }

  /* Subtle Fintech Grid Background */
  .bg-grid-pattern {
    background-size: 40px 40px;
    background-image: radial-gradient(circle, #e5e7eb 1px, transparent 1px);
    mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
  }

  /* Smooth accordion */
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] summary ~ * { animation: sweep 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes sweep {
    0%    { opacity: 0; transform: translateY(-8px); }
    100%  { opacity: 1; transform: translateY(0); }
  }
</style>

<!-- Header / Navigation -->
